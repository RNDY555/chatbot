generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  nume        String
  prenume     String
  departament String
  rol         String   @default("MEMBRU")

  tickets     Ticket[]
}

model Ticket {
  id           String    @id @default(cuid())

  subiect      String
  descriere    String
  documentText String?

  status       String    @default("NEREZOLVAT")

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  resolvedAt   DateTime?

  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
}