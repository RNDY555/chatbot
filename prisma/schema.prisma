generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  nume        String
  prenume     String
  departament String
  rol         String   @default("MEMBRU")
  messages    Message[]
}

model Message {
  id        String   @id @default(cuid())
  text      String
  sender    String   
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}